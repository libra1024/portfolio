---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section id="contact" class="py-16 md:py-24 px-4 md:px-8 reveal">
    <h2 class="section-title" set:html={t('section.contact').replace(/Touch|Contacto/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <div class="max-w-2xl mx-auto bg-[var(--bg-color)] border border-[var(--dust-stroke)] rounded-2xl p-8 md:p-12 text-center shadow-sm">
        <p class="text-lg md:text-xl text-[var(--ink)] opacity-80 mb-8">{t('contact.text')}</p>
        <a href={`mailto:${data.contact.email}`} class="inline-block px-8 py-3 rounded-lg bg-[var(--ink)] text-[var(--bg-color)] font-medium hover:opacity-90 transition-opacity shadow-md">
            {t('contact.btn')}
        </a>
    </div>
</section>
