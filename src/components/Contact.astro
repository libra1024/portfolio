---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section id="contact" class="py-24 px-8 reveal">
    <h2 class="section-title" set:html={t('section.contact').replace(/Touch|Contacto/g, match => `<span class="text-brand">${match}</span>`)}></h2>
    <div class="max-w-2xl mx-auto bg-white border border-dust-stroke rounded-2xl p-12 text-center shadow-sm">
        <p class="text-xl text-gray-600 mb-8">{t('contact.text')}</p>
        <a href={`mailto:${data.contact.email}`} class="inline-block px-8 py-3 rounded-lg bg-ink text-white font-medium hover:bg-gray-800 transition-colors shadow-md">
            {t('contact.btn')}
        </a>
    </div>
</section>
