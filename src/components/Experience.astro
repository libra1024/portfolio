---
import { cvData } from '../data/cv.js';
---
<section id="experience" class="section reveal">
    <h2 class="section-title">Professional <span class="gradient-text">Experience</span></h2>
    <div class="timeline">
        {cvData.experience.map(job => (
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>{job.role}</h3>
                    <h4>{job.company} <span>| {job.period}</span></h4>
                    <p>{job.description}</p>
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .timeline {
        max-width: 800px;
        margin: 0 auto;
        position: relative;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 2px;
        background: var(--glass-border);
    }
    .timeline-item {
        position: relative;
        padding-left: 3rem;
        margin-bottom: 3rem;
    }
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    .timeline-dot {
        position: absolute;
        left: -4px;
        top: 0;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-blue);
        box-shadow: 0 0 10px var(--accent-blue);
    }
    .timeline-content h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    .timeline-content h4 {
        font-size: 1rem;
        color: var(--accent-violet);
        margin-bottom: 1rem;
        font-family: var(--font-sans);
    }
    .timeline-content h4 span {
        color: var(--text-muted);
        font-weight: 400;
    }
    .timeline-content p {
        color: var(--text-muted);
        line-height: 1.6;
    }
</style>
