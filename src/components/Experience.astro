---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<article id="experience" class="bento-card h-full flex flex-col">
    <h2 class="text-xl font-bold mb-6" set:html={t('section.experience').replace(/Experience|Profesional/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <div class="relative border-l border-[var(--dust-stroke)] ml-2 flex-grow">
        {data.experience.map((job, idx) => (
            <div class={`relative pl-6 ${idx !== data.experience.length - 1 ? 'pb-8' : ''}`}>
                <div class="absolute left-[-5px] top-1.5 w-2.5 h-2.5 rounded-full bg-[var(--bg-color)] border border-[var(--brand)] shadow-[0_0_8px_rgba(0,51,255,0.4)]"></div>
                <h3 class="text-base font-bold text-[var(--ink)]">{job.role}</h3>
                <h4 class="text-[var(--brand)] text-sm font-medium mb-2">
                    {job.company} 
                    <span class="text-[var(--ink)] opacity-50 font-normal ml-2 text-xs">{job.period}</span>
                </h4>
                <ul class="list-disc list-outside ml-4 mt-2 space-y-1 text-[var(--ink)] opacity-70 leading-relaxed text-xs md:text-sm">
                    {/* @ts-ignore */}
                    {job.description.map((item: string) => (
                        <li>{item}</li>
                    ))}
                </ul>
                {/* @ts-ignore */}
                {job.links && (
                    <div class="flex flex-wrap gap-3 mt-3">
                        {/* @ts-ignore */}
                        {job.links.map((link: {name: string, url: string}) => (
                            <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-xs font-medium text-[var(--brand)] hover:opacity-80 transition-opacity">
                                {link.name}
                                <svg class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </a>
                        ))}
                    </div>
                )}
            </div>
        ))}
    </div>
</article>
