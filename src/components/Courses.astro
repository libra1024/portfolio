---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<article id="courses" class="bento-card h-full">
    <h2 class="text-xl font-bold mb-6" set:html={t('section.courses').replace(/Courses|Cursos/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {data.courses.map(course => (
            <a href={course.url} target="_blank" rel="noopener noreferrer" class="block bg-[var(--fog-50)] border border-[var(--dust-stroke)] p-4 rounded-xl hover:border-[var(--brand)] transition-colors group">
                <div class="flex justify-between items-start mb-1">
                    <h3 class="text-sm font-semibold text-[var(--ink)] group-hover:text-[var(--brand)] transition-colors pr-2 leading-tight">{course.name}</h3>
                </div>
                <div class="flex items-center justify-between mt-3">
                    <span class="text-[10px] font-medium bg-[var(--fog-100)] border border-[var(--dust-stroke)] text-[var(--ink)] opacity-70 px-2 py-0.5 rounded-full whitespace-nowrap">{course.date}</span>
                    <svg class="w-3.5 h-3.5 text-[var(--brand)] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </div>
            </a>
        ))}
    </div>
</article>
