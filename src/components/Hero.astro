---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section class="min-h-screen flex items-center justify-center pt-24 pb-12 px-8">
    <div class="max-w-4xl text-center">
        <div class="inline-block px-4 py-1.5 rounded-full bg-fog-100 border border-dust-stroke text-sm font-medium text-gray-600 mb-8">
            {t('hero.available')}
        </div>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-ink mb-6">
            {t('hero.title1')} <br/>
            <span class="text-brand">{t('hero.title2')}</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
            {data.about.split('.')[0]}.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#contact" class="px-8 py-3 rounded-lg bg-brand text-white font-medium hover:bg-blue-700 transition-colors">{t('hero.cta')}</a>
            <a href="#experience" class="px-8 py-3 rounded-lg bg-white text-ink border border-dust-stroke font-medium hover:bg-fog-50 transition-colors shadow-sm">{t('hero.viewWork')}</a>
        </div>
    </div>
</section>
