---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<article id="hero" class="bento-card flex flex-col justify-center h-full relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-[var(--brand)] opacity-10 rounded-full blur-3xl group-hover:opacity-30 transition-opacity duration-500"></div>
    <div class="relative z-10">
        <div class="inline-block px-3 py-1 rounded-full bg-[var(--fog-100)] border border-[var(--dust-stroke)] text-xs font-semibold text-[var(--ink)] opacity-80 mb-6">
            {t('hero.available')}
        </div>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-[var(--ink)] mb-4">
            {t('hero.title1')} <br/>
            <span class="text-[var(--brand)]">{t('hero.title2')}</span>
        </h1>
        <p class="text-sm md:text-base text-[var(--ink)] opacity-70 mb-8 max-w-xl">
            {data.about.split('.')[0]}.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="#contact" class="px-6 py-2 rounded-lg bg-[var(--brand)] text-white font-medium hover:opacity-90 transition-opacity text-center text-sm">{t('hero.cta')}</a>
            <a href="#experience" class="px-6 py-2 rounded-lg bg-[var(--bg-color)] text-[var(--ink)] border border-[var(--dust-stroke)] font-medium hover:bg-[var(--fog-50)] transition-colors text-center text-sm">{t('hero.viewWork')}</a>
        </div>
    </div>
</article>
