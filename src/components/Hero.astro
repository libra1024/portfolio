---
// src/components/Hero.astro
---
<section id="hero" class="hero reveal">
    <div class="hero-bg-glow"></div>
    <div class="hero-content">
        <span class="eyebrow">libra1024</span>
        <h1>Engineering <span class="gradient-text">Autonomous AI</span><br> & Robust Backends.</h1>
        <p>I transform ideas into technology. Designing ETL processes, building agentic workflows, and developing intelligent support systems.</p>
        <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">Let's Talk</a>
            <a href="#experience" class="btn btn-secondary">View Experience</a>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 0 2rem;
        text-align: center;
    }
    .hero-bg-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(124,58,237,0.15) 0%, transparent 70%);
        pointer-events: none;
        z-index: -1;
    }
    .eyebrow {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 1px solid rgba(124,58,237,0.3);
        background: rgba(124,58,237,0.1);
        color: #c4b5fd;
        border-radius: 2rem;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        margin-bottom: 1.5rem;
    }
    .hero h1 {
        font-size: clamp(3rem, 5vw, 5rem);
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }
    .hero p {
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto 2.5rem;
    }
    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }
    .btn {
        padding: 0.8rem 2rem;
        border-radius: 2rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .btn-primary {
        background: var(--accent-violet);
        color: white;
        border: 1px solid transparent;
    }
    .btn-primary:hover {
        background: #6d28d9;
        box-shadow: 0 0 20px rgba(124,58,237,0.4);
    }
    .btn-secondary {
        background: var(--glass-bg);
        color: white;
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(10px);
    }
    .btn-secondary:hover {
        background: rgba(255,255,255,0.08);
    }
</style>
