---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section class="min-h-[90vh] flex items-center justify-center pt-32 pb-12 px-4 md:px-8">
    <div class="max-w-4xl text-center">
        <div class="inline-block px-4 py-1.5 rounded-full bg-[var(--fog-100)] border border-[var(--dust-stroke)] text-sm font-medium text-[var(--ink)] opacity-80 mb-8">
            {t('hero.available')}
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-[var(--ink)] mb-6">
            {t('hero.title1')} <br/>
            <span class="text-[var(--brand)]">{t('hero.title2')}</span>
        </h1>
        <p class="text-base md:text-lg lg:text-xl text-[var(--ink)] opacity-70 mb-10 max-w-2xl mx-auto">
            {data.about.split('.')[0]}.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#contact" class="px-8 py-3 rounded-lg bg-[var(--brand)] text-white font-medium hover:opacity-90 transition-opacity">{t('hero.cta')}</a>
            <a href="#experience" class="px-8 py-3 rounded-lg bg-[var(--bg-color)] text-[var(--ink)] border border-[var(--dust-stroke)] font-medium hover:bg-[var(--fog-50)] transition-colors shadow-sm">{t('hero.viewWork')}</a>
        </div>
    </div>
</section>
