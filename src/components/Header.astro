---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Helper for relative links
const getPath = (path: string) => lang === 'en' ? path : `/${lang}${path}`;
---
<header id="header" class="fixed top-0 left-0 w-full z-50 py-4 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-transparent">
    <nav class="max-w-6xl mx-auto px-8 flex justify-between items-center">
        <div class="font-bold text-2xl text-ink tracking-tight">RH</div>
        <ul class="flex items-center gap-8 list-none">
            <li><a href={getPath('/#about')} class="text-sm font-medium text-gray-600 hover:text-brand transition-colors">{t('nav.about')}</a></li>
            <li><a href={getPath('/#skills')} class="text-sm font-medium text-gray-600 hover:text-brand transition-colors">{t('nav.skills')}</a></li>
            <li><a href={getPath('/#experience')} class="text-sm font-medium text-gray-600 hover:text-brand transition-colors">{t('nav.experience')}</a></li>
            <li><a href={getPath('/#contact')} class="text-sm font-medium text-gray-600 hover:text-brand transition-colors">{t('nav.contact')}</a></li>
            <li class="pl-4 border-l border-dust-stroke flex gap-2">
                <a href="/" class={`text-sm font-medium transition-colors ${lang === 'en' ? 'text-brand' : 'text-gray-400 hover:text-gray-600'}`}>EN</a>
                <span class="text-gray-300">|</span>
                <a href="/es/" class={`text-sm font-medium transition-colors ${lang === 'es' ? 'text-brand' : 'text-gray-400 hover:text-gray-600'}`}>ES</a>
            </li>
        </ul>
    </nav>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header?.classList.add('border-dust-stroke', 'shadow-sm', 'py-3');
                header?.classList.remove('border-transparent', 'py-4');
            } else {
                header?.classList.remove('border-dust-stroke', 'shadow-sm', 'py-3');
                header?.classList.add('border-transparent', 'py-4');
            }
        });
    });
</script>
