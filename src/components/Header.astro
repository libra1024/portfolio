---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getPath = (path: string) => lang === 'en' ? path : `/${lang}${path}`;
---
<header id="header" class="fixed top-0 left-0 w-full z-50 py-4 transition-all duration-300 bg-[var(--bg-color)]/80 backdrop-blur-md border-b border-transparent">
    <nav class="max-w-6xl mx-auto px-4 md:px-8 flex justify-between items-center relative">
        <div class="font-bold text-2xl text-[var(--ink)] tracking-tight">RH</div>
        
        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-[var(--ink)]" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>

        <ul id="nav-menu" class="absolute md:relative top-full left-0 w-full md:w-auto bg-[var(--bg-color)] md:bg-transparent border-b md:border-none border-[var(--dust-stroke)] hidden md:flex flex-col md:flex-row items-center gap-4 md:gap-8 p-4 md:p-0 shadow-lg md:shadow-none list-none">
            <li><a href={getPath('/#about')} class="text-sm font-medium text-[var(--ink)] opacity-70 hover:opacity-100 hover:text-[var(--brand)] transition-colors block py-2 md:py-0">{t('nav.about')}</a></li>
            <li><a href={getPath('/#skills')} class="text-sm font-medium text-[var(--ink)] opacity-70 hover:opacity-100 hover:text-[var(--brand)] transition-colors block py-2 md:py-0">{t('nav.skills')}</a></li>
            <li><a href={getPath('/#experience')} class="text-sm font-medium text-[var(--ink)] opacity-70 hover:opacity-100 hover:text-[var(--brand)] transition-colors block py-2 md:py-0">{t('nav.experience')}</a></li>
            <li><a href={getPath('/#courses')} class="text-sm font-medium text-[var(--ink)] opacity-70 hover:opacity-100 hover:text-[var(--brand)] transition-colors block py-2 md:py-0">{t('nav.courses')}</a></li>
            <li><a href={getPath('/#contact')} class="text-sm font-medium text-[var(--ink)] opacity-70 hover:opacity-100 hover:text-[var(--brand)] transition-colors block py-2 md:py-0">{t('nav.contact')}</a></li>
            
            <li class="md:pl-4 md:border-l border-[var(--dust-stroke)] flex items-center py-2 md:py-0">
                <div class="relative flex items-center bg-[var(--fog-100)] rounded-full p-1 border border-[var(--dust-stroke)] shadow-inner">
                    <div class={`absolute h-[24px] w-[36px] bg-[var(--bg-color)] rounded-full shadow-sm transition-transform duration-300 ease-in-out border border-[var(--dust-stroke)] ${lang === 'en' ? 'translate-x-0' : 'translate-x-[36px]'}`}></div>
                    <a href="/" class={`relative z-10 flex items-center justify-center h-[24px] w-[36px] text-[10px] font-bold transition-colors ${lang === 'en' ? 'text-[var(--brand)]' : 'text-[var(--ink)] opacity-60 hover:opacity-100'}`}>EN</a>
                    <a href="/es/" class={`relative z-10 flex items-center justify-center h-[24px] w-[36px] text-[10px] font-bold transition-colors ${lang === 'es' ? 'text-[var(--brand)]' : 'text-[var(--ink)] opacity-60 hover:opacity-100'}`}>ES</a>
                </div>
            </li>

            <!-- Theme Toggle -->
            <li class="py-2 md:py-0">
                <button id="theme-toggle" class="p-2 rounded-full hover:bg-[var(--fog-100)] transition-colors text-[var(--ink)] opacity-70 hover:opacity-100" aria-label="Toggle Theme">
                    <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                </button>
            </li>
        </ul>
    </nav>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Scroll Effect
        const header = document.getElementById('header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header?.classList.add('border-[var(--dust-stroke)]', 'shadow-sm', 'py-3');
                header?.classList.remove('border-transparent', 'py-4');
            } else {
                header?.classList.remove('border-[var(--dust-stroke)]', 'shadow-sm', 'py-3');
                header?.classList.add('border-transparent', 'py-4');
            }
        });

        // Mobile Menu
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const navMenu = document.getElementById('nav-menu');
        mobileBtn?.addEventListener('click', () => {
            navMenu?.classList.toggle('hidden');
            navMenu?.classList.toggle('flex');
        });

        // Close menu on link click
        navMenu?.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 768) {
                    navMenu?.classList.add('hidden');
                    navMenu?.classList.remove('flex');
                }
            });
        });

        // Theme Toggle Logic
        const themeBtn = document.getElementById('theme-toggle');
        const iconLight = document.getElementById('theme-icon-light');
        const iconDark = document.getElementById('theme-icon-dark');
        const themes = ['light', 'dark'];
        
        let currentTheme = localStorage.getItem('theme');
        if (currentTheme !== 'light' && currentTheme !== 'dark') {
            currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
            localStorage.setItem('theme', currentTheme);
        }

        const updateThemeUI = (theme) => {
            iconLight?.classList.add('hidden');
            iconDark?.classList.add('hidden');

            if (theme === 'light') iconLight?.classList.remove('hidden');
            if (theme === 'dark') iconDark?.classList.remove('hidden');

            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        };

        themeBtn?.addEventListener('click', () => {
            const currentIndex = themes.indexOf(currentTheme);
            currentTheme = themes[(currentIndex + 1) % themes.length];
            localStorage.setItem('theme', currentTheme);
            updateThemeUI(currentTheme);
        });

        // Init
        updateThemeUI(currentTheme);
    });
</script>
