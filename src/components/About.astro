---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section id="about" class="py-16 md:py-24 px-4 md:px-8 max-w-4xl mx-auto reveal">
    <h2 class="section-title" set:html={t('section.about').replace(/Me|Mí/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <p class="text-base md:text-lg leading-relaxed text-[var(--ink)] opacity-80 text-center">
        {data.about}
    </p>
</section>
