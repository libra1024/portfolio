---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<article id="about" class="bento-card h-full flex flex-col justify-center">
    <h2 class="text-xl font-bold mb-4" set:html={t('section.about').replace(/Me|Mí/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <p class="text-sm md:text-base leading-relaxed text-[var(--ink)] opacity-80">
        {data.about}
    </p>
</article>
