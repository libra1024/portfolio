---
import { cvData } from '../data/cv.js';
---
<section id="about" class="section reveal">
    <h2 class="section-title">About <span class="gradient-text">Me</span></h2>
    <div class="about-content">
        <p>{cvData.about}</p>
    </div>
</section>

<style>
    .about-content p {
        font-size: 1.2rem;
        line-height: 1.8;
        color: var(--text-muted);
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }
</style>
