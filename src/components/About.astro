---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section id="about" class="py-24 px-8 max-w-4xl mx-auto reveal">
    <h2 class="section-title" set:html={t('section.about').replace(/Me|Mí/g, match => `<span class="text-brand">${match}</span>`)}></h2>
    <p class="text-lg leading-relaxed text-gray-600 text-center">
        {data.about}
    </p>
</section>
