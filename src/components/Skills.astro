---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<section id="skills" class="py-24 px-8 max-w-5xl mx-auto reveal bg-fog-50 rounded-3xl border border-dust-stroke my-12">
    <h2 class="section-title" set:html={t('section.skills').replace(/Skills|Clave/g, match => `<span class="text-brand">${match}</span>`)}></h2>
    <div class="flex flex-wrap gap-3 justify-center">
        {data.skills.map(skill => (
            <div class="bg-white border border-dust-stroke px-5 py-2.5 rounded-full font-medium text-ink shadow-sm hover:border-brand hover:text-brand transition-colors cursor-default">
                {skill}
            </div>
        ))}
    </div>
</section>
