---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { cvData } from '../data/cv.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data = cvData[lang as keyof typeof cvData];
---
<article id="skills" class="bento-card h-full">
    <h2 class="text-xl font-bold mb-6" set:html={t('section.skills').replace(/Skills|Clave/g, match => `<span class="text-[var(--brand)]">${match}</span>`)}></h2>
    <div class="flex flex-wrap gap-2">
        {data.skills.map(skill => (
            <span class="bg-[var(--fog-50)] border border-[var(--dust-stroke)] px-3 py-1.5 rounded-lg text-xs md:text-sm font-medium text-[var(--ink)] hover:border-[var(--brand)] hover:text-[var(--brand)] transition-colors cursor-default">
                {skill}
            </span>
        ))}
    </div>
</article>
