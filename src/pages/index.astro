---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Courses from '../components/Courses.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Portfolio | libra1024">
	<Header />
	<main class="flex-grow pt-28 pb-16 px-4 md:px-8 max-w-7xl mx-auto w-full">
		<div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-auto">
			<div class="md:col-span-2 lg:col-span-2 lg:row-span-2">
				<Hero />
			</div>
			
			<div class="md:col-span-1 lg:col-span-2">
				<About />
			</div>

			<div class="md:col-span-3 lg:col-span-2 lg:row-span-3">
				<Experience />
			</div>

			<div class="md:col-span-3 lg:col-span-2">
				<Skills />
			</div>

			<div class="md:col-span-2 lg:col-span-2">
				<Courses />
			</div>

			<div class="md:col-span-1 lg:col-span-4">
				<Contact />
			</div>
		</div>
	</main>
</Layout>
